# ---------- Database (Neon Serverless PostgreSQL) ----------
# Paste your Neon connection string, e.g.
# postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---------- Auth ----------
# Any long random string used to sign session cookies
AUTH_SECRET=

# ---------- Resend (transactional emails) ----------
# https://resend.com/api-keys — ready to send once your custom domain is verified
RESEND_API_KEY=
# e.g. "Jowdi Restaurant <no-reply@jowdi-restaurant.com>" (falls back to onboarding@resend.dev)
RESEND_FROM_EMAIL=

# ---------- App ----------
# Your Vercel deployment URL, e.g. https://jowdi.vercel.app
NEXT_PUBLIC_APP_URL=
